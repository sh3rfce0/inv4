local text="$1"
local width=50  # Sesuaikan dengan panjang baris yang diinginkan
local plain_text=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
local len=${#plain_text}
local spaces=$(( (width - len) / 2 ))
printf "%${spaces}s%s\033[0m\n" "" "$(echo -e "$text")"
}
