loading() {
local pid=$1
local delay=0.1
local spin='-\|/'
while ps -p $pid > /dev/null; do
local temp=${spin#?}
printf "[%c] " "$spin"
local spin=$temp${spin%"$temp"}
sleep $delay
printf "\b\b\b\b\b\b"
done
printf "    \b\b\b\b"
}
