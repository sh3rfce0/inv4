echo -e '\033[1;32mwaiting...\e[0m'
sudo apt-get update >/dev/null 2>&1
sudo apt-get install parallel -y >/dev/null 2>&1
CPU_CORES=$(nproc --all)
heavy_task() {
echo "Thread $1 mulai..."
for i in {1..1000000}; do :; done
echo "Thread $1 selesai."
}
export -f heavy_task
LOG_FILE="thread_performance.log"
echo "Waktu Mulai: $(date)" > $LOG_FILE
seq $CPU_CORES | parallel -j $CPU_CORES heavy_task {} >> $LOG_FILE 2>&1
echo "Waktu Selesai: $(date)" >> $LOG_FILE
echo "Semua thread selesai. Data performa disimpan di $LOG_FILE."